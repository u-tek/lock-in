// Identity and service settings shared by every target.
//
// These defaults build and run in the simulator. For a device or TestFlight build, copy
// Config/Local.xcconfig.example to Config/Local.xcconfig (gitignored) and fill in the real
// values there. CI writes Local.xcconfig from repository secrets for TestFlight uploads.

LK_TEAM_ID =
LK_BUNDLE_ID = com.example.lockin
LK_APP_GROUP = group.$(LK_BUNDLE_ID)

// Host of the API Worker deployed from /server, e.g. lockin-api.yourname.workers.dev.
// Host only: "//" starts a comment here. Empty: the app runs without a backend (solo only).
LK_API_HOST =

// Host of the website, e.g. lockin.app (M9): the paywall's Terms and Privacy links and Settings >
// About's Support, Privacy Policy and Terms rows open https://<host>/terms and so on. Host only,
// as above. Empty: the pages are on LK_API_HOST (the Worker serves them too); with neither, the
// links are hidden. CI fills it from the optional LK_WEB_HOST secret.
LK_WEB_HOST =

// RevenueCat's public API key for the app (appl_…, M7). Empty: Lockin Plus is sold through
// StoreKit 2 directly. CI fills it from the optional LK_REVENUECAT_KEY secret.
LK_REVENUECAT_KEY =

// YES until launch: shows the Developer menu (APNs spike, Live Activity Lab) in TestFlight
// builds, which the owner can't run from Xcode. Set NO for the App Store (M9 checklist).
LK_DEVELOPER_TOOLS = YES

#include? "Local.xcconfig"
